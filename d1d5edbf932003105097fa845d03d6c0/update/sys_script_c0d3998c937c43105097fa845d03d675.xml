        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

    var slaScore = 0;

    if(current.u_integer_3 > 0){

        slaScore = (current.u_integer_5 / current.u_integer_3) * 100;
    }

    var delayPenalty = current.u_decimal_6 * 0.2;

    var performance = slaScore - delayPenalty;

    current.u_decimal_7 = performance;

    if(performance >= 90){

        current.u_integer_9 = 1;
        current.u_integer_8 = 100;
    }
    else if(performance >= 75){

        current.u_integer_9 = 2;
        current.u_integer_8 = 70;
    }
    else{

        current.u_integer_9 = 3;
        current.u_integer_8 = 40;
    }

})(current, previous);]]></script>
